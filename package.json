{
  "dependencies": {
    "@erseco/autofirma-client": "^1.9.3"
  },
  "devDependencies": {
    "@matbee/libreoffice-converter": "^2.7.2",
    "@noble/hashes": "^2.4.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@wordpress/e2e-test-utils-playwright": "^3.0.0",
    "@wordpress/env": "^11.17.0",
    "@wordpress/scripts": "^37.0.0",
    "esbuild": "^0.28.2",
    "jquery": "^3.7.1",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "wp-env": "wp-env",
    "composer": "wp-env run cli --config=.wp-env.docker.json --env-cwd=wp-content/plugins/documentate composer",
    "composer:tests-cli": "wp-env run tests-cli --config=.wp-env.docker.json --env-cwd=wp-content/plugins/documentate composer",
    "test:e2e": "wp-scripts test-playwright --config tests/e2e/playwright.config.js",
    "test:unit": "wp-env run tests-cli --config=.wp-env.docker.json --env-cwd=wp-content/plugins/documentate ./vendor/bin/phpunit",
    "test:unit-js": "wp-scripts test-unit-js",
    "copy:libreoffice-converter": "node scripts/copy-libreoffice-converter.mjs",
    "build:autofirma": "esbuild assets/js/documentate-autofirma.js --bundle --format=iife --outfile=admin/js/documentate-autofirma.js --sourcemap && cp node_modules/@erseco/autofirma-client/vendor/autoscript.js admin/js/vendor/autoscript.js",
    "postinstall": "npm run copy:libreoffice-converter && npm run build:autofirma",
    "postupdate": "npm run copy:libreoffice-converter && npm run build:autofirma"
  }
}
